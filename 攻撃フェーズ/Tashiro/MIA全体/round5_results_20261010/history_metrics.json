{
  "created_date": "2026-10-10",
  "scope": "Direct original official HTML extraction for rounds 1-5; no truth labels, no scoring rerun, no submission-file changes",
  "method": "HTML entity decode then parse pre JSON and LB table. AIA power is numpy.nanmean of all 22 returned aia_per_target values. Historial audit summary metrics are not extraction inputs.",
  "environment": {
    "python": "3.12.15 (main, Sep 30 2026, 22:04:19) [Clang 21.0.0 (clang-2100.3.34.2)]",
    "numpy": "2.4.6",
    "platform": "macOS-27.0.1-arm64-arm-64bit"
  },
  "metric_definitions": {
    "MIA_all": "mean over targets of TPR at FPR=.01 from all 1049 candidate rows",
    "MIA_rare": "nanmean over defined target rare-stratum TPR at FPR=.01; targets with zero rare members produce NaN and are excluded",
    "MIA_auc": "mean target AUC, diagnostic and not an attack score component",
    "MIA_power": "mean over targets of max(TPR_all_k,TPR_rare_k) with fallback to all when rare is undefined; not max of the returned aggregate means",
    "AIA_all": "mean target R_all where R=clip((p_m-p_c)/(1-p_c),0,1), tau_time=.5",
    "AIA_rare": "mean defined target R_rare after z=1.64 SE deadzone; not the raw rare R and not an additional floor-adjusted channel",
    "AIA_corrected_power": "mean over targets of clip(max(R_all_k,R_rare_k)-aia_floor_k,0,1); directly obtainable from the returned aia_per_target array",
    "AIA_floor": "per-target organizer truth-side floor; its values are not reconstructed from aggregate p_m/p_c",
    "total": "MIA_power + AIA_corrected_power",
    "MIA_exact_availability": "HTML breakdown has no exact MIA power. R2/R4 exact score_1 from original scores.json permits derivation to machine precision; R1/R3/R5 only displayed total permits an interval",
    "rounding": "Official renderer uses Python .4f. Conservative closed +/-0.00005 decimal envelopes are reported, not fabricated exact totals. Float summation differences below 1e-15 do not affect any reported sign conclusion."
  },
